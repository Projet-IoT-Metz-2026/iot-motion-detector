@model IEnumerable<IoTDetectorDashboard.Models.SensorData>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6"><i class="bi bi-speedometer2"></i> Dashboard IoT Motion Detector</h1>
            <p class="text-muted">Surveillance en temps réel des capteurs PIR</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Devices</h6>
                            <h2 class="display-4 mb-0">@ViewBag.TotalDevices</h2>
                        </div>
                        <div class="fs-1">
                            <i class="bi bi-hdd-network"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-primary bg-opacity-50">
                    <a href="@Url.Action("Index", "Devices")" class="text-white text-decoration-none">
                        Voir tous les devices <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Active Devices</h6>
                            <h2 class="display-4 mb-0">@ViewBag.ActiveDevices</h2>
                        </div>
                        <div class="fs-1">
                            <i class="bi bi-wifi"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-success bg-opacity-50">
                    <span class="text-white">Connectés à Azure IoT Hub</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Unacknowledged Alerts</h6>
                            <h2 class="display-4 mb-0">@ViewBag.TotalAlerts</h2>
                        </div>
                        <div class="fs-1">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-warning bg-opacity-50">
                    <a href="@Url.Action("Index", "Alerts", new { acknowledged = false })" class="text-white text-decoration-none">
                        Gérer les alertes <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Detections</h6>
                            <h2 class="display-4 mb-0">@ViewBag.TotalDetections</h2>
                        </div>
                        <div class="fs-1">
                            <i class="bi bi-eye"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-info bg-opacity-50">
                    <span class="text-white">Mouvements détectés (total)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-graph-up"></i> Activité des capteurs (24h)
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="sensorActivityChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle"></i> État du système
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Devices actifs</span>
                            <span class="badge bg-success">@ViewBag.ActiveDevices / @ViewBag.TotalDevices</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @((ViewBag.TotalDevices > 0 ? (ViewBag.ActiveDevices * 100.0 / ViewBag.TotalDevices) : 0))%"
                                 aria-valuenow="@ViewBag.ActiveDevices" aria-valuemin="0" aria-valuemax="@ViewBag.TotalDevices">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Alertes non traitées</span>
                            <span class="badge bg-warning text-dark">@ViewBag.TotalAlerts</span>
                        </div>
                    </div>

                    <hr>

                    <h6 class="mb-3">Connexion Azure IoT Hub</h6>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">
                            <i class="bi bi-check-circle"></i> Connected
                        </span>
                        <small class="text-muted">iot-iotdetector-dev</small>
                    </div>

                    <hr>

                    <h6 class="mb-3">Base de données</h6>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">
                            <i class="bi bi-check-circle"></i> Connected
                        </span>
                        <small class="text-muted">PostgreSQL</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock-history"></i> Activité récente (24h)
                    </h5>
                    <span class="badge bg-primary" id="realTimeIndicator">
                        <i class="bi bi-broadcast"></i> Temps réel
                    </span>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover" id="recentActivityTable">
                                <thead>
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Device ID</th>
                                        <th>Type d'événement</th>
                                        <th>Motion Count</th>
                                        <th>RSSI</th>
                                        <th>Free Memory</th>
                                        <th>Firmware</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var data in Model)
                                    {
                                        <tr>
                                            <td>
                                                <small>@data.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Devices", new { id = data.DeviceId })" class="text-decoration-none">
                                                    <strong>@data.DeviceId</strong>
                                                </a>
                                            </td>
                                            <td>
                                                @if (data.EventType == "motion_detected")
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-eye-fill"></i> @data.EventType
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-heartbeat"></i> @data.EventType
                                                    </span>
                                                }
                                            </td>
                                            <td>@(data.MotionCount?.ToString() ?? "-")</td>
                                            <td>
                                                @if (data.Rssi.HasValue)
                                                {
                                                    <span class="badge @(data.Rssi > -70 ? "bg-success" : data.Rssi > -80 ? "bg-warning text-dark" : "bg-danger")">
                                                        @data.Rssi dBm
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                            <td>@(data.FreeMemory.HasValue ? $"{data.FreeMemory / 1024} KB" : "-")</td>
                                            <td><small>@(data.FirmwareVersion ?? "-")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> Aucune donnée disponible pour les dernières 24 heures.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sensor Activity Chart (Line Chart)
        const ctx = document.getElementById('sensorActivityChart');

        // Prepare data from model
        const sensorData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (Model ?? Enumerable.Empty<IoTDetectorDashboard.Models.SensorData>()).Select(d => new {
                timestamp = d.Timestamp,
                deviceId = d.DeviceId,
                eventType = d.EventType,
                motionCount = d.MotionCount ?? 0
            }).OrderBy(d => d.timestamp).ToList()
        ));

        // Group data by hour for better visualization
        const groupedByHour = {};
        sensorData.forEach(item => {
            const date = new Date(item.timestamp);
            const hourKey = date.getFullYear() + '-' +
                           String(date.getMonth() + 1).padStart(2, '0') + '-' +
                           String(date.getDate()).padStart(2, '0') + ' ' +
                           String(date.getHours()).padStart(2, '0') + ':00';

            if (!groupedByHour[hourKey]) {
                groupedByHour[hourKey] = 0;
            }
            if (item.eventType === 'motion_detected') {
                groupedByHour[hourKey]++;
            }
        });

        const labels = Object.keys(groupedByHour).sort();
        const dataPoints = labels.map(label => groupedByHour[label]);

        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels.map(l => {
                    const parts = l.split(' ');
                    return parts[1]; // Only show time
                }),
                datasets: [{
                    label: 'Détections de mouvement',
                    data: dataPoints,
                    borderColor: 'rgb(220, 53, 69)',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });

        // SignalR Real-time Connection (placeholder for future implementation)
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/sensorHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveSensorData", function (data) {
            console.log("New sensor data received:", data);

            // Add new row to table
            const tableBody = document.querySelector('#recentActivityTable tbody');
            if (tableBody) {
                const newRow = tableBody.insertRow(0);
                // Populate row with data (implement later)
            }

            // Update chart with new data point
            // chart.data.labels.push(newLabel);
            // chart.data.datasets[0].data.push(newValue);
            // chart.update();

            // Update statistics cards
            // document.querySelector('.total-detections').textContent = newTotal;
        });

        connection.start()
            .then(function () {
                console.log("SignalR connected");
                document.getElementById('realTimeIndicator').classList.add('pulse');
            })
            .catch(function (err) {
                console.error("SignalR connection error:", err.toString());
                document.getElementById('realTimeIndicator').classList.remove('pulse');
            });

        // Pulse animation for real-time indicator
        const style = document.createElement('style');
        style.textContent = `
            .pulse {
                animation: pulse 2s infinite;
            }
            @@keyframes pulse {
                0% { opacity: 1; }
                50% { opacity: 0.5; }
                100% { opacity: 1; }
            }
        `;
        document.head.appendChild(style);
    </script>
}
