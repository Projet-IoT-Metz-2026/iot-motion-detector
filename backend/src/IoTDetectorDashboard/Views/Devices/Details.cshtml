@model IoTDetectorDashboard.Models.Device
@{
    ViewData["Title"] = "Device Details - " + Model.DeviceId;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Devices")">Devices</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.DeviceId</li>
                </ol>
            </nav>
            <h1 class="display-6">
                <i class="bi bi-hdd-network"></i> @Model.DeviceId
            </h1>
            <p class="text-muted">Device Details and Sensor Data History</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Index", "Devices")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Devices
            </a>
        </div>
    </div>

    <!-- Device Information Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Device Type</h6>
                    @if (Model.DeviceType == "ESP32")
                    {
                        <h4><span class="badge bg-info"><i class="bi bi-cpu"></i> @Model.DeviceType</span></h4>
                    }
                    else if (Model.DeviceType == "Photon2")
                    {
                        <h4><span class="badge bg-primary"><i class="bi bi-cloud"></i> @Model.DeviceType</span></h4>
                    }
                    else
                    {
                        <h4><span class="badge bg-secondary">@Model.DeviceType</span></h4>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Connection Status</h6>
                    @if (Model.Status == "Connected")
                    {
                        <h4><span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> @Model.Status</span></h4>
                    }
                    else
                    {
                        <h4><span class="badge bg-danger"><i class="bi bi-x-circle-fill"></i> @Model.Status</span></h4>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Last Connected</h6>
                    @if (Model.LastConnected.HasValue)
                    {
                        <p class="mb-0"><small>@Model.LastConnected.Value.ToString("dd/MM/yyyy")</small></p>
                        <p class="mb-0"><small>@Model.LastConnected.Value.ToString("HH:mm:ss")</small></p>
                    }
                    else
                    {
                        <p class="text-muted">Never</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Last Data Received</h6>
                    @if (Model.LastDataReceived.HasValue)
                    {
                        <p class="mb-0"><small>@Model.LastDataReceived.Value.ToString("dd/MM/yyyy")</small></p>
                        <p class="mb-0"><small>@Model.LastDataReceived.Value.ToString("HH:mm:ss")</small></p>
                    }
                    else
                    {
                        <p class="text-muted">No data</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Detections</h6>
                            <h3 class="mb-0">@Model.SensorDataList.Count(s => s.EventType == "motion_detected")</h3>
                        </div>
                        <div class="fs-2 text-danger">
                            <i class="bi bi-eye-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-secondary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Heartbeats</h6>
                            <h3 class="mb-0">@Model.SensorDataList.Count(s => s.EventType == "heartbeat")</h3>
                        </div>
                        <div class="fs-2 text-secondary">
                            <i class="bi bi-heartbeat"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Average RSSI</h6>
                            <h3 class="mb-0">
                                @{
                                    var avgRssi = Model.SensorDataList.Where(s => s.Rssi.HasValue).Select(s => s.Rssi.Value).DefaultIfEmpty(0).Average();
                                }
                                @avgRssi.ToString("F0") dBm
                            </h3>
                        </div>
                        <div class="fs-2 text-info">
                            <i class="bi bi-reception-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Firmware Version</h6>
                            <h5 class="mb-0">
                                @{
                                    var latestFirmware = Model.SensorDataList.OrderByDescending(s => s.Timestamp).FirstOrDefault()?.FirmwareVersion;
                                }
                                @(latestFirmware ?? "Unknown")
                            </h5>
                        </div>
                        <div class="fs-2 text-warning">
                            <i class="bi bi-code-square"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-graph-up"></i> Motion Detection Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="motionChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-reception-4"></i> Signal Strength (RSSI)
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="rssiChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-memory"></i> Free Memory Over Time
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="memoryChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock"></i> Device Uptime
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="uptimeChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Sensor Data Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-table"></i> Recent Sensor Data (Last 100 entries)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.SensorDataList != null && Model.SensorDataList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Event Type</th>
                                        <th>Motion Count</th>
                                        <th>RSSI</th>
                                        <th>Free Memory</th>
                                        <th>Uptime</th>
                                        <th>Firmware</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var data in Model.SensorDataList.OrderByDescending(s => s.Timestamp).Take(100))
                                    {
                                        <tr>
                                            <td><small>@data.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</small></td>
                                            <td>
                                                @if (data.EventType == "motion_detected")
                                                {
                                                    <span class="badge bg-danger"><i class="bi bi-eye-fill"></i> @data.EventType</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary"><i class="bi bi-heartbeat"></i> @data.EventType</span>
                                                }
                                            </td>
                                            <td>@(data.MotionCount?.ToString() ?? "-")</td>
                                            <td>
                                                @if (data.Rssi.HasValue)
                                                {
                                                    <span class="badge @(data.Rssi > -70 ? "bg-success" : data.Rssi > -80 ? "bg-warning text-dark" : "bg-danger")">
                                                        @data.Rssi dBm
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                            <td>@(data.FreeMemory.HasValue ? $"{data.FreeMemory / 1024} KB" : "-")</td>
                                            <td>@(data.Uptime.HasValue ? TimeSpan.FromSeconds(data.Uptime.Value).ToString(@"hh\:mm\:ss") : "-")</td>
                                            <td><small>@(data.FirmwareVersion ?? "-")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> No sensor data available for this device.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Prepare sensor data from model
        const sensorData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.SensorDataList.OrderBy(s => s.Timestamp).Select(d => new {
                timestamp = d.Timestamp,
                eventType = d.EventType,
                motionCount = d.MotionCount ?? 0,
                rssi = d.Rssi ?? 0,
                freeMemory = d.FreeMemory ?? 0,
                uptime = d.Uptime ?? 0
            }).ToList()
        ));

        // Format timestamps
        const timestamps = sensorData.map(d => {
            const date = new Date(d.timestamp);
            return date.toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit' });
        });

        // Motion Detection Chart
        new Chart(document.getElementById('motionChart'), {
            type: 'bar',
            data: {
                labels: timestamps,
                datasets: [{
                    label: 'Motion Count',
                    data: sensorData.map(d => d.eventType === 'motion_detected' ? d.motionCount : 0),
                    backgroundColor: 'rgba(220, 53, 69, 0.7)',
                    borderColor: 'rgb(220, 53, 69)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });

        // RSSI Chart
        new Chart(document.getElementById('rssiChart'), {
            type: 'line',
            data: {
                labels: timestamps,
                datasets: [{
                    label: 'RSSI (dBm)',
                    data: sensorData.map(d => d.rssi),
                    borderColor: 'rgb(13, 110, 253)',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: false
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });

        // Free Memory Chart
        new Chart(document.getElementById('memoryChart'), {
            type: 'line',
            data: {
                labels: timestamps,
                datasets: [{
                    label: 'Free Memory (KB)',
                    data: sensorData.map(d => d.freeMemory / 1024),
                    borderColor: 'rgb(25, 135, 84)',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });

        // Uptime Chart
        new Chart(document.getElementById('uptimeChart'), {
            type: 'line',
            data: {
                labels: timestamps,
                datasets: [{
                    label: 'Uptime (hours)',
                    data: sensorData.map(d => d.uptime / 3600),
                    borderColor: 'rgb(255, 193, 7)',
                    backgroundColor: 'rgba(255, 193, 7, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    </script>
}
