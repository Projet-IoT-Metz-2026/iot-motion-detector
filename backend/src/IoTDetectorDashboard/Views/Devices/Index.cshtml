@model IEnumerable<IoTDetectorDashboard.Models.Device>
@{
    ViewData["Title"] = "Devices";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-6"><i class="bi bi-hdd-network"></i> Devices IoT</h1>
            <p class="text-muted">Gestion des capteurs PIR connectés à Azure IoT Hub</p>
        </div>
        <div class="col-md-4 text-end">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-primary" onclick="refreshDevices()">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Devices Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Devices</h6>
                            <h3 class="mb-0">@Model.Count()</h3>
                        </div>
                        <div class="fs-2 text-primary">
                            <i class="bi bi-hdd-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Connected</h6>
                            <h3 class="mb-0">@Model.Count(d => d.Status == "Connected")</h3>
                        </div>
                        <div class="fs-2 text-success">
                            <i class="bi bi-wifi"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Disconnected</h6>
                            <h3 class="mb-0">@Model.Count(d => d.Status != "Connected")</h3>
                        </div>
                        <div class="fs-2 text-danger">
                            <i class="bi bi-wifi-off"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Devices Table -->
    <div class="card">
        <div class="card-header bg-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-list-ul"></i> Liste des Devices
            </h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="devicesTable">
                        <thead>
                            <tr>
                                <th>Device ID</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Last Connected</th>
                                <th>Last Data Received</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@device.DeviceId</strong>
                                    </td>
                                    <td>
                                        @if (device.DeviceType == "ESP32")
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-cpu"></i> @device.DeviceType
                                            </span>
                                        }
                                        else if (device.DeviceType == "Photon2")
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-cloud"></i> @device.DeviceType
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@device.DeviceType</span>
                                        }
                                    </td>
                                    <td>
                                        @if (device.Status == "Connected")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill"></i> Connected
                                            </span>
                                        }
                                        else if (device.Status == "Disconnected")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill"></i> Disconnected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-question-circle-fill"></i> @device.Status
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (device.LastConnected.HasValue)
                                        {
                                            <small>@device.LastConnected.Value.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (device.LastDataReceived.HasValue)
                                        {
                                            var timeDiff = DateTime.UtcNow - device.LastDataReceived.Value;
                                            if (timeDiff.TotalMinutes < 5)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-clock"></i> @timeDiff.TotalMinutes.ToString("F0")m ago
                                                </span>
                                            }
                                            else if (timeDiff.TotalHours < 1)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-clock"></i> @timeDiff.TotalMinutes.ToString("F0")m ago
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-clock"></i> @timeDiff.TotalHours.ToString("F1")h ago
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", new { id = device.DeviceId })"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="deleteDevice('@device.DeviceId')"
                                                    title="Delete Device">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle"></i> Aucun device enregistré. Les devices seront automatiquement ajoutés lors de la première connexion à Azure IoT Hub.
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete device <strong id="deleteDeviceId"></strong>?
                <br>
                <small class="text-danger">This action will also delete all associated sensor data and cannot be undone.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteDevice(deviceId) {
            document.getElementById('deleteDeviceId').textContent = deviceId;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + deviceId;

            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        function refreshDevices() {
            location.reload();
        }

        // Auto-refresh every 30 seconds
        setInterval(function() {
            console.log('Auto-refreshing device list...');
            // Use AJAX to refresh without full page reload (implement later)
        }, 30000);
    </script>
}
