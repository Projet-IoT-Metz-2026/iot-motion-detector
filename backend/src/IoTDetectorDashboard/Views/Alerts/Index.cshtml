@model IEnumerable<IoTDetectorDashboard.Models.Alert>
@{
    ViewData["Title"] = "Alerts";
    var deviceIdFilter = ViewBag.DeviceId as string;
    var acknowledgedFilter = ViewBag.Acknowledged as bool?;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-6"><i class="bi bi-exclamation-triangle"></i> Alertes</h1>
            <p class="text-muted">Gestion des alertes et notifications du système IoT</p>
        </div>
        <div class="col-md-4 text-end">
            <button type="button" class="btn btn-outline-primary" onclick="refreshAlerts()">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Alert Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Alerts</h6>
                            <h3 class="mb-0">@Model.Count()</h3>
                        </div>
                        <div class="fs-2 text-warning">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Unacknowledged</h6>
                            <h3 class="mb-0">@Model.Count(a => !a.Acknowledged)</h3>
                        </div>
                        <div class="fs-2 text-danger">
                            <i class="bi bi-exclamation-circle-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Acknowledged</h6>
                            <h3 class="mb-0">@Model.Count(a => a.Acknowledged)</h3>
                        </div>
                        <div class="fs-2 text-success">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-funnel"></i> Filtres
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-4">
                    <label for="deviceId" class="form-label">Device ID</label>
                    <input type="text" class="form-control" id="deviceId" name="deviceId"
                           value="@deviceIdFilter" placeholder="Filter by device ID">
                </div>
                <div class="col-md-4">
                    <label for="acknowledged" class="form-label">Status</label>
                    <select class="form-select" id="acknowledged" name="acknowledged">
                        <option value="">All Alerts</option>
                        <option value="false" selected="@(acknowledgedFilter.HasValue && !acknowledgedFilter.Value)">Unacknowledged</option>
                        <option value="true" selected="@(acknowledgedFilter.HasValue && acknowledgedFilter.Value)">Acknowledged</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Apply Filters
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Alerts Table -->
    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="bi bi-list-ul"></i> Liste des Alertes
            </h5>
            @if (Model.Any(a => !a.Acknowledged))
            {
                <button type="button" class="btn btn-sm btn-warning" onclick="acknowledgeAll()">
                    <i class="bi bi-check-all"></i> Acknowledge All Pending
                </button>
            }
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="alertsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Timestamp</th>
                                <th>Device ID</th>
                                <th>Alert Type</th>
                                <th>Message</th>
                                <th>Status</th>
                                <th>Acknowledged At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in Model)
                            {
                                <tr class="@(alert.Acknowledged ? "" : "table-warning")">
                                    <td><strong>#@alert.Id</strong></td>
                                    <td>
                                        <small>@alert.Timestamp.ToString("dd/MM/yyyy")</small><br>
                                        <small>@alert.Timestamp.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Devices", new { id = alert.DeviceId })" class="text-decoration-none">
                                            <strong>@alert.DeviceId</strong>
                                        </a>
                                    </td>
                                    <td>
                                        @if (alert.AlertType == "motion_threshold")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-eye-fill"></i> @alert.AlertType
                                            </span>
                                        }
                                        else if (alert.AlertType == "device_offline")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-wifi-off"></i> @alert.AlertType
                                            </span>
                                        }
                                        else if (alert.AlertType == "low_memory")
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-memory"></i> @alert.AlertType
                                            </span>
                                        }
                                        else if (alert.AlertType == "weak_signal")
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-reception-1"></i> @alert.AlertType
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">
                                                <i class="bi bi-question-circle"></i> @alert.AlertType
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small>@alert.Message</small>
                                    </td>
                                    <td>
                                        @if (alert.Acknowledged)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Acknowledged
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split"></i> Pending
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (alert.AcknowledgedAt.HasValue)
                                        {
                                            <small>@alert.AcknowledgedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            @if (!alert.Acknowledged)
                                            {
                                                <form method="post" asp-action="Acknowledge" asp-route-id="@alert.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Acknowledge">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="deleteAlert(@alert.Id)"
                                                    title="Delete Alert">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle"></i>
                    @if (!string.IsNullOrEmpty(deviceIdFilter) || acknowledgedFilter.HasValue)
                    {
                        <span>Aucune alerte ne correspond aux filtres sélectionnés.</span>
                    }
                    else
                    {
                        <span>Aucune alerte enregistrée dans le système.</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete alert <strong id="deleteAlertId"></strong>?
                <br>
                <small class="text-danger">This action cannot be undone.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteAlert(alertId) {
            document.getElementById('deleteAlertId').textContent = '#' + alertId;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + alertId;

            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        function acknowledgeAll() {
            if (confirm('Are you sure you want to acknowledge all pending alerts?')) {
                // Get all unacknowledged alert forms and submit them
                const forms = document.querySelectorAll('form[action*="Acknowledge"]');

                // Submit first form (others will be handled via page refresh)
                if (forms.length > 0) {
                    forms[0].submit();
                }
            }
        }

        function refreshAlerts() {
            location.reload();
        }

        // Auto-refresh every 30 seconds
        setInterval(function() {
            console.log('Auto-refreshing alerts list...');
            // Use AJAX to refresh without full page reload (implement later)
        }, 30000);

        // Real-time updates via SignalR (placeholder)
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/sensorHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveAlert", function (alert) {
            console.log("New alert received:", alert);

            // Show notification
            if (Notification.permission === "granted") {
                new Notification("New IoT Alert", {
                    body: alert.message,
                    icon: "/favicon.ico"
                });
            }

            // Refresh table or add new row (implement later)
            // location.reload();
        });

        connection.start()
            .catch(function (err) {
                console.error("SignalR connection error:", err.toString());
            });

        // Request notification permission
        if (Notification.permission === "default") {
            Notification.requestPermission();
        }
    </script>
}
