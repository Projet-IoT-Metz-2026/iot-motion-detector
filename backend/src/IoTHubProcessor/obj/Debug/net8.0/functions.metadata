[
  {
    "name": "IoTHubProcessor",
    "scriptFile": "IoTHubProcessor.dll",
    "entryPoint": "IoTHubProcessor.IoTHubProcessor.Run",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "messages",
        "direction": "In",
        "type": "eventHubTrigger",
        "eventHubName": "%EventHubName%",
        "connection": "EventHubConnectionString",
        "cardinality": "Many",
        "properties": {
          "supportsDeferredBinding": "True"
        }
      }
    ]
  }
]