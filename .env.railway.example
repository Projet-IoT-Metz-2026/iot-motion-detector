# ===================================================================
# Railway.app Environment Variables Template
# ===================================================================
# Copy these variables to Railway Dashboard → Settings → Variables
# Replace placeholder values with your actual credentials
# ===================================================================

# ===== Azure IoT Hub Configuration =====
# Get from: Azure Portal → IoT Hub → Shared access policies → iothubowner
Azure__IoTHub__ConnectionString=HostName=iot-iotdetector-dev.azure-devices.net;SharedAccessKeyName=iothubowner;SharedAccessKey=YOUR_AZURE_KEY_HERE
Azure__IoTHub__Enabled=true

# ===== Particle Cloud Configuration =====
# Enable Particle Cloud listener for Photon2 devices
Particle__Enabled=true
Particle__EventName=pir_motion
# Optional: Particle Access Token (leave empty to use Railway shell login)
Particle__AccessToken=

# ===== Database Configuration =====
# Use InMemory for Railway Free tier (no persistent storage needed for demo)
Database__Provider=InMemory
Database__SeedData=false

# For PostgreSQL (if you add a Railway PostgreSQL service):
# Database__Provider=PostgreSQL
# ConnectionStrings__DefaultConnection=${{Postgres.DATABASE_URL}}

# ===== ASP.NET Core Configuration =====
ASPNETCORE_ENVIRONMENT=Production

# ===== Railway Auto-Configured (DO NOT SET) =====
# PORT - Railway sets this automatically
# RAILWAY_ENVIRONMENT - Set by Railway
# RAILWAY_SERVICE_NAME - Set by Railway

# ===================================================================
# How to Apply These Variables on Railway:
# ===================================================================
# 1. Go to Railway Dashboard
# 2. Select your service
# 3. Go to "Settings" → "Variables"
# 4. Click "+ New Variable" for each variable above
# 5. Click "Redeploy" to apply changes
#
# Note: Railway variables support references like ${{Postgres.DATABASE_URL}}
# ===================================================================

# ===================================================================
# Expected Devices:
# ===================================================================
# 1. esp32-pir-01 (ESP32 → Azure IoT Hub)
# 2. photon2-pir-01 (Photon2 → Particle Cloud)
# ===================================================================
